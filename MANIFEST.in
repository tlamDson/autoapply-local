include README.md README.vi.md LICENSE NOTICE AGENTS.md CLAUDE.md
include requirements.txt pyproject.toml MANIFEST.in setup.py export-allowlist.json .gitignore
recursive-include autoapply_local *.py *.tex *.md *.json *.cjs
recursive-include scripts *.py
recursive-include examples *.json
recursive-include templates *.md
recursive-include .codex *.md
recursive-include .claude *.md
recursive-include .github *.yml
prune tests
prune user
prune logs
prune runs
prune browser
prune backups
prune build
prune dist
global-exclude *.pyc
global-exclude __pycache__
